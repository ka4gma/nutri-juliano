  "narrative": {
    "northStar": "Sob Medida",
    "overview": "O sistema vem do retrato do cliente com o adipometro: a ferramenta de medir vira a linguagem visual. Regua e linha de cota medem o conteudo, nunca enfeitam. Ardosia e papel alternados, um unico acento latao, tipografia display condensada contra pesos finos, filetes de 1px, sem sombras.",
    "keyCharacteristics": [
      "Dois temas de secao alternados (escuro e papel), fechando em faixa latao.",
      "Filete de 1px e a unica divisoria.",
      "Movimento so revela e respeita prefers-reduced-motion.",
      "Mono reservada a medida."
    ],
    "rules": [
      { "name": "The One Brass Rule", "body": "Latao e o unico acento. Sobre papel vira latao-esc para texto e filete.", "section": "colors" },
      { "name": "The Theme Variable Rule", "body": "Cor secundaria, filete e acento vem de --muted, --line, --rule, --accent, --focus do tema da secao.", "section": "colors" },
      { "name": "The Measure-Only Mono Rule", "body": "DM Mono so onde ha dimensao ou indice.", "section": "typography" },
      { "name": "The Stretch Pairing Rule", "body": "Titulo pesado e condensado ao lado de linha leve em largura normal.", "section": "typography" },
      { "name": "The Flat Rule", "body": "Superficies planas; estado por cor, filete ou deslocamento, nunca sombra.", "section": "elevation" }
    ],
    "dos": [
      "Do usar latao como unico acento e latao-esc para texto sobre papel.",
      "Do ler cor secundaria, filete e acento das variaveis do tema da secao.",
      "Do abrir cada capitulo com Mark e usar Cota apenas para dimensao real do conteudo.",
